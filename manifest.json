{
  "manifest_version": 3,
  "name": "WebShield - Security & Vulnerability Scanner",
  "version": "1.0.0",
  "description": "Analyze website security in one click. Detect client-side vulnerabilities, OWASP flaws, header policies, secrets, and form risks.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scan Website Vulnerabilities",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
